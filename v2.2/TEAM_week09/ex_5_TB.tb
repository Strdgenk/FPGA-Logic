LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
 
-- 2학년 2반 2021041028 김호중
-- 2학년 2반 2021041080 정승현
-- RIPPLE COUNTER 응용
 
ENTITY ex_5_TB IS
END ex_5_TB;
 
ARCHITECTURE behavior OF ex_5_TB IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT ex_5
    PORT(
         clk : IN  std_logic;
         rst : IN  std_logic;
         jq : OUT  std_logic_vector(3 downto 0);
         beep : OUT  std_logic;
         load : IN  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal clk : std_logic := '0';
   signal rst : std_logic := '1';
   signal load : std_logic := '1';

 	--Outputs
   signal jq : std_logic_vector(3 downto 0);
   signal beep : std_logic;
 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: ex_5 PORT MAP (
          clk => clk,
          rst => rst,
          jq => jq,
          beep => beep,
          load => load
        );

   -- Clock process definitions
   clk_process :process
	begin
		clk <= not clk;
		wait for 25 ns;
	end process;
 

   -- Stimulus process
   res_proc: process
	begin
		wait for 200 ns;
		rst <= '1'; wait;
	end process;

END;
