LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
--2학년 2반 2021041064 이정일, 2학년 2021041080 정승현
--week4 jk,t 플립플롭 순차처리문
 
ENTITY week4_2_tb IS
END week4_2_tb;
 
ARCHITECTURE behavior OF week4_2_tb IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT week4_2
    PORT(
         jk : IN  std_logic_vector(1 downto 0);
         t : IN  std_logic;
         clk : IN  std_logic;
         t_q : buffer  std_logic;
         t_qvar : buffer  std_logic;
         jk_q : buffer  std_logic;
         jk_qvar : buffer  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal jk : std_logic_vector(1 downto 0) := "10";
   signal t : std_logic := '1';
   signal clk : std_logic := '0';

 	--Outputs
   signal t_q : std_logic;
   signal t_qvar : std_logic;
   signal jk_q : std_logic;
   signal jk_qvar : std_logic;
	
   -- Clock period definitions
   constant clk_period : time := 10 ns;
 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: week4_2 PORT MAP (
          jk => jk,
          t => t,
          clk => clk,
          t_q => t_q,
          t_qvar => t_qvar,
          jk_q => jk_q,
          jk_qvar => jk_qvar
        );

 
 

   -- Stimulus process
   clk_proc: process
   begin	
		clk <= not clk; wait for 50 ns;
	end process;
	
	INPUT : process
	begin
	wait for 60 ns;
	t<= '1'; jk <= "00"; wait for 160 ns;
	t<= '1'; jk <= "01"; wait for 160 ns;
	t<= '1'; jk <= "10"; wait for 160 ns;
	t<= '1'; jk <= "11"; wait for 160 ns;
	t<= '0'; jk <= "00"; wait for 160 ns;
	t<= '0'; jk <= "01"; wait for 160 ns;
	t<= '0'; jk <= "10"; wait for 160 ns;
	t<= '0'; jk <= "11"; wait for 160 ns;
	end process;
      


END;
