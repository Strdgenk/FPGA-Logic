LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
 
--2학년 2반 2021041064 이정일
--2학년 2반 2021041080 정승현
 
ENTITY week6_3_tb IS
END week6_3_tb;
 
ARCHITECTURE behavior OF week6_3_tb IS 
 
     -- Component Declaration for the Unit Under Test (UUT)
    COMPONENT week6_3
    PORT(
         RESET : IN  std_logic;
         CLK : IN  std_logic;
         Y : OUT  std_logic_vector(3 downto 0)
        );
    END COMPONENT;
    

   --Inputs
   signal RESET : std_logic := '0';
   signal CLK : std_logic := '0';

   --Outputs
   signal Y : std_logic_vector(3 downto 0);

BEGIN
 

   uut: week6_3 PORT MAP (
          RESET => RESET,
          CLK => CLK,
          Y => Y
        );

  
   clk_process :process
   begin
		CLK <= not CLK; 
		wait for 25 ns;
   end process;
 

   stimulus_process : process
   begin		

        RESET <= '0';
        wait for 50 ns;  
        RESET <= '1';  
        wait for 50 ns;
        RESET <= '0';
        wait for 50 ns;
        RESET <= '1';   
   end process;

END behavior;
