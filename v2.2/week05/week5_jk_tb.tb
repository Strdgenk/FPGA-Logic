LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
 
--2학년 2반 2021041064 이정일, 2학년 2021041080 정승현
--week5 jk 동기식 플립플롭 
 
ENTITY week5_jk_tb IS
END week5_jk_tb;
 
ARCHITECTURE behavior OF week5_jk_tb IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT week5_jk
    PORT(
         jk : IN  std_logic_vector(1 downto 0);
         jk_q : BUFFER std_logic;
         jk_qvar : BUFFER  std_logic;
         clk : IN  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal jk : std_logic_vector(1 downto 0) := "10";
   signal clk : std_logic := '0';

 	--Outputs
   signal jk_q : std_logic;
   signal jk_qvar : std_logic;

   -- Clock period definitions
   constant clk_period : time := 10 ns;
 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: week5_jk PORT MAP (
          jk => jk,
          jk_q => jk_q,
          jk_qvar => jk_qvar,
          clk => clk
        );
 


clk_proc: process
   begin	
		clk <= not clk; wait for 50 ns;
	end process;
	
	INPUT : process
	begin
	wait for 60 ns;
	jk <= "00"; wait for 160 ns;
	jk <= "01"; wait for 160 ns;
	jk <= "10"; wait for 160 ns;
	jk <= "11"; wait for 160 ns;

	end process;
      

END;
