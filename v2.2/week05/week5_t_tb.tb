LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
 
--2학년 2반 2021041064 이정일, 2학년 2021041080 정승현
--week5 t 동기식 플립플롭 
 
ENTITY week5_t_tb IS
END week5_t_tb;
 
ARCHITECTURE behavior OF week5_t_tb IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT week5_t
    PORT(
         t : IN  std_logic;
         clk : IN  std_logic;
         t_q : BUFFER  std_logic;
         t_qvar : BUFFER  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal t : std_logic := '1';
   signal clk : std_logic := '0';

 	--Outputs
   signal t_q : std_logic;
   signal t_qvar : std_logic;

 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: week5_t PORT MAP (
          t => t,
          clk => clk,
          t_q => t_q,
          t_qvar => t_qvar
        );

 

    clk_proc: process
   begin	
		clk <= not clk; wait for 50 ns;
	end process;
	
	INPUT : process
	begin
	wait for 60 ns;
	t<= '1';  wait for 160 ns;
	t<= '1';  wait for 160 ns;
	t<= '1';  wait for 160 ns;
	t<= '1';  wait for 160 ns;
	t<= '0';  wait for 160 ns;
	t<= '0';  wait for 160 ns;
	t<= '0';  wait for 160 ns;
	t<= '0';  wait for 160 ns;
	end process;

END;
