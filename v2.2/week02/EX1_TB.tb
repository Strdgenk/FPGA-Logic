LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
USE ieee.std_logic_unsigned.ALL;
USE ieee.numeric_std.ALL;
 
--2학년 2반 2021041080 정승현
--4BIT 멀티플렉서_순차처리문 IF_ELSLF
 
ENTITY EX1_TB IS
END EX1_TB;
 
ARCHITECTURE behavior OF EX1_TB IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT EX1
    PORT(
         X0 : IN  std_logic;
         X1 : IN  std_logic;
         X2 : IN  std_logic;
         X3 : IN  std_logic;
         X4 : IN  std_logic;
         X5 : IN  std_logic;
         Y0 : OUT  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal X0 : std_logic := '0';
   signal X1 : std_logic := '0';
   signal X2 : std_logic := '0';
   signal X3 : std_logic := '0';
   signal X4 : std_logic := '0';
   signal X5 : std_logic := '0';

 	--Outputs
   signal Y0 : std_logic;
	
	signal se1 : std_logic_vector(1 downto 0) := "00";
	signal data: std_logic_vector(3 downto 0) := "1111";
 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: EX1 PORT MAP (
          X0 => X0,
          X1 => X1,
          X2 => X2,
          X3 => X3,
          X4 => X4,
          X5 => X5,
          Y0 => Y0
        );
 

   -- Stimulus process
   se1_proc: process
   begin		
		wait for 200 ns;
		se1<= se1+1;
   end process;
	x5<=se1(1);x4<=se1(0);
	
	data_proc: process
	begin
		data<= "0001";wait for 50 ns;
		data<= "0010";wait for 50 ns;
		data<= "0100";wait for 50 ns;
		data<= "1000";wait for 50 ns;
	end process;
	x3<=data(3);x2<=data(2);x1<=data(1);x0<=data(0);
END;
