ARCHITECTURE behavior OF WEEK7_3_TB IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT WEEK7_3
    PORT(
         X : IN  std_logic_vector(2 downto 0);
         Y : OUT  std_logic_vector(3 downto 0)
        );
    END COMPONENT;
    

   --Inputs
   signal X : std_logic_vector(2 downto 0) := (others => '0');

 	--Outputs
   signal Y : std_logic_vector(3 downto 0);
  
 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: WEEK7_3 PORT MAP (
          X => X,
          Y => Y
        );

 -- Stimulus process
 
stim_proc_SONY: process
begin
	-- hold reset state for 100 ns.
	wait for 100 ns;
	x<="001"; wait for 100 ns;
	x<="010"; wait for 100 ns;
	x<="011"; wait for 100 ns;
	x<="100"; wait for 100 ns;
	x<="101"; wait for 100 ns;
	x<="110"; wait for 100 ns;
	x<="111"; wait;
   end process;

END;
