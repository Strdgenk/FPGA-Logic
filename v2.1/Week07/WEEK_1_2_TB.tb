LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
 
-- 2학년 2반 2019041073 손대영, 2학년 2반 2021041080 정승현
 
ENTITY WEEK_1_2_TB IS
END WEEK_1_2_TB;
 
ARCHITECTURE behavior OF WEEK_1_2_TB IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT WEEK_1_2
    PORT(
         X0 : IN  std_logic;
         X1 : IN  std_logic;
         X2 : IN  std_logic;
         X3 : IN  std_logic;
         Y0 : OUT  std_logic;
         Y1 : OUT  std_logic;
         Y2 : OUT  std_logic;
         Y3 : OUT  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal X0 : std_logic := '0';
   signal X1 : std_logic := '0';
   signal X2 : std_logic := '0';
   signal X3 : std_logic := '0';

 	--Outputs
   signal Y0 : std_logic;
   signal Y1 : std_logic;
   signal Y2 : std_logic;
   signal Y3 : std_logic;

 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: WEEK_1_2 PORT MAP (
          X0 => X0,
          X1 => X1,
          X2 => X2,
          X3 => X3,
          Y0 => Y0,
          Y1 => Y1,
          Y2 => Y2,
          Y3 => Y3
        );

 

   -- Stimulus process
   stim_proc: process
   begin		
	X3<='0';X2<='0'; X1<='0'; X0<='0'; wait for 50ns;
	X3<='0';X2<='0'; X1<='0'; X0<='1'; wait for 50ns;
	X3<='0';X2<='0'; X1<='1'; X0<='0'; wait for 50ns;
	X3<='0';X2<='0'; X1<='1'; X0<='1'; wait for 50ns;
	X3<='0';X2<='1'; X1<='0'; X0<='0'; wait for 50ns;
	X3<='0';X2<='1'; X1<='0'; X0<='1'; wait for 50ns;
	X3<='0';X2<='1'; X1<='1'; X0<='0'; wait for 50ns;
	X3<='0';X2<='1'; X1<='1'; X0<='1'; wait for 50ns;
	X3<='1';X2<='0'; X1<='0'; X0<='0'; wait for 50ns;
	X3<='1';X2<='0'; X1<='0'; X0<='1'; wait for 50ns;
	X3<='1';X2<='0'; X1<='1'; X0<='0'; wait for 50ns;
	X3<='1';X2<='0'; X1<='1'; X0<='1'; wait for 50ns;
	X3<='1';X2<='1'; X1<='0'; X0<='0'; wait for 50ns;
	X3<='1';X2<='1'; X1<='0'; X0<='1'; wait for 50ns;
	X3<='1';X2<='1'; X1<='1'; X0<='0'; wait for 50ns;
	X3<='1';X2<='1'; X1<='1'; X0<='1'; wait for 50ns;
	wait;
	
   end process;

END;
