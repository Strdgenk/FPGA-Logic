LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
 
-- WEEK5
-- AND, OR, XOR, INVERTER, BUFFER
-- 2학년_2반_2021041080_정승현   
 
ENTITY AND_OR_XOR_INVERTER_BUFFER_TB IS
END AND_OR_XOR_INVERTER_BUFFER_TB;
 
ARCHITECTURE behavior OF AND_OR_XOR_INVERTER_BUFFER_TB IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT AND_OR_XOR_INVERTER_BUFFER
    PORT(
         X0 : IN  std_logic;
         X1 : IN  std_logic;
         X2 : IN  std_logic;
         Y0 : OUT  std_logic;
         Y1 : OUT  std_logic;
         Y2 : OUT  std_logic;
         Y3 : OUT  std_logic;
         Y4 : OUT  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal X0 : std_logic := '0';
   signal X1 : std_logic := '0';
   signal X2 : std_logic := '0';

 	--Outputs
   signal Y0 : std_logic;
   signal Y1 : std_logic;
   signal Y2 : std_logic;
   signal Y3 : std_logic;
   signal Y4 : std_logic;

 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: AND_OR_XOR_INVERTER_BUFFER PORT MAP (
          X0 => X0,
          X1 => X1,
          X2 => X2,
          Y0 => Y0,
          Y1 => Y1,
          Y2 => Y2,
          Y3 => Y3,
          Y4 => Y4
        );
 

   -- Stimulus process
   stim_proc: process
   begin		
      -- hold reset state for 100 ns.
      wait for 100 ns;	
		X0 <= '0' ; X1 <= '0' ; X2 <= '0' ; wait for 100 ns;
		X0 <= '0' ; X1 <= '0' ; X2 <= '1' ; wait for 100 ns;
		X0 <= '0' ; X1 <= '1' ; X2 <= '0' ; wait for 100 ns;
		X0 <= '0' ; X1 <= '1' ; X2 <= '1' ; wait for 100 ns;
		X0 <= '1' ; X1 <= '0' ; X2 <= '0' ; wait for 100 ns;
		X0 <= '1' ; X1 <= '0' ; X2 <= '1' ; wait for 100 ns;
		X0 <= '1' ; X1 <= '1' ; X2 <= '0' ; wait for 100 ns;
		X0 <= '1' ; X1 <= '1' ; X2 <= '1' ; wait for 100 ns;


      wait;
   end process;
