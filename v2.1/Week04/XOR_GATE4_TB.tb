END XOR_GATE4_TB;
 
ARCHITECTURE behavior OF XOR_GATE4_TB IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT XOR_GATE4
    PORT(
         A : IN  std_logic;
         B : IN  std_logic;
         Y : OUT  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal A : std_logic := '0';
   signal B : std_logic := '0';

 	--Outputs
