ARCHITECTURE behavior OF INVERTER4_TB IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT INVERTER4
    PORT(
         x7 : IN  std_logic;
         y7 : OUT  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal x7 : std_logic := '0';

 	--Outputs
