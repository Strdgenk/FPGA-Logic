LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
USE ieee.std_logic_unsigned.ALL;
USE ieee.numeric_std.ALL;
 
-- 2학년_2반_2021041080_정승현
-- WEEK14 Cascading 과제 2
 
ENTITY week14_2_TB IS
END week14_2_TB;
 
ARCHITECTURE behavior OF week14_2_TB IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT week14_2
    PORT(
         A : IN  std_logic_vector(3 downto 0);
         B : IN  std_logic_vector(3 downto 0);
         Y : OUT  std_logic_vector(5 downto 0);
			FND : OUT  std_logic_vector(7 downto 0);
			Q : OUT  std_logic_vector(3 downto 0);
         Cascading : IN  std_logic_vector(2 downto 0)
        );
    END COMPONENT;
    

   --Inputs
   signal A : std_logic_vector(3 downto 0) := "0001";
   signal B : std_logic_vector(3 downto 0) := "0000";
   signal Cascading : std_logic_vector(2 downto 0) := "000";

 	--Outputs
   signal Y : std_logic_vector(5 downto 0);
	signal FND : std_logic_vector(7 downto 0);
	signal Q : std_logic_vector(3 downto 0);
 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: week14_2 PORT MAP (
          A => A,
          B => B,
          Y => Y,
			 FND => FND,
          Q => Q,
          Cascading => Cascading
        );
 

   -- Stimulus process
   stim_proc: process
   begin		
      wait for 100 ns;	
		A <= A+1; B <= B+1; Cascading <= Cascading+1; 
   end process;

END;
